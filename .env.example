# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=la-cle-anon-ou-publishable
# Clé secrète (service_role) : uniquement côté serveur, jamais dans le navigateur.
SUPABASE_SERVICE_ROLE_KEY=la-cle-service-role

# Adresse publique du site (sans / à la fin), utilisée dans les liens à partager
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Numéro WhatsApp du support MonDjassa (format international sans +), ex : 2250700000000
NEXT_PUBLIC_SUPPORT_WHATSAPP=2250700000000
